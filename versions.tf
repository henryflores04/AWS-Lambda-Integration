# Cuenta AWS actual. Se usa en outputs.tf como evidencia para el PDF.
data "aws_caller_identity" "current" {}

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
  }
}
